[Defines]
  INF_VERSION                    = 1.25
  BASE_NAME                      = UefiApplicationHvLoader
  FILE_GUID                      = 81D164E8-E0C8-4B08-BBBB-B54FECF22059
  MODULE_TYPE                    = UEFI_APPLICATION
  VERSION_STRING                 = 1.0
  ENTRY_POINT                    = UefiApplicationHvLoaderMain

[Sources]
  UefiApplicationHvLoader.c

[Packages]
  MdePkg/MdePkg.dec
  MdeModulePkg/MdeModulePkg.dec
  HypervysePkg/HypervysePkg.dec

[LibraryClasses]
  DebugLib
  UefiApplicationEntryPoint
  UefiLib
  UefiBootServicesTableLib
  UefiRuntimeServicesTableLib
  MemoryAllocationLib
  BaseMemoryLib
  PcdLib

[Pcd]
  gHypervyseTokenSpaceGuid.PcdSiliconVendor
